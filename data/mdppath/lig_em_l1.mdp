define                  = -DFLEXIBLE
integrator              = steep
emtol                   = 100
nsteps                  = 5000
nstlist                 = 10
cutoff-scheme           = Verlet
rlist                   = 0.9
vdwtype                 = Cut-off
vdw-modifier            = None
DispCorr                = EnerPres
rvdw                    = 0.9
coulombtype             = PME
rcoulomb                = 0.9
;
constraints             = h-bonds
constraint_algorithm    = LINCS

; Free energy control stuff
free-energy              = yes
init-lambda              = 1
delta-lambda             = 0
sc-alpha                 = 0.3
sc-sigma                 = 0.25
sc-power                 = 1
sc-coul                  = yes